# OpenCredit AI backend configuration
# Copy this file to `.env` and fill in real values.

# Required for agent reasoning and Ask OpenCredit (leave empty to run in
# limited mode — self-reported parsing and user-provided URLs still work).
OPENAI_API_KEY=

# Comma-separated list of allowed browser origins.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where investigation records are stored (JSON files, relative to repo root).
INVESTIGATIONS_DIR=data/investigations

# Parallel investigations.
MAX_CONCURRENT_INVESTIGATIONS=2

# Ask OpenCredit model settings.
ASK_MODEL=gpt-4o-mini
ASK_TEMPERATURE=0.2
